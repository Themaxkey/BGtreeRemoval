---
import { getEntry, render } from 'astro:content';
import { site } from '../../site.config';
import BaseLayout from '../layouts/BaseLayout.astro';
import ServiceGrid from '../components/ServiceGrid.astro';
import TownGrid from '../components/TownGrid.astro';

const entry = await getEntry('pages', 'home');
if (!entry) throw new Error('Missing src/content/pages/home.md');
const { Content } = await render(entry);
const d = entry.data;
---
<BaseLayout seoTitle={d.seoTitle} description={d.description} pageType="home">
  <section class="hero">
    <div class="wrap">
      <h1>{d.title}</h1>
      <p>{d.tagline ?? d.description}</p>
      <div class="cta">
        <a class="cta-primary" href={`tel:${site.business.phoneRaw}`}>Call {site.business.phone}</a>
        <a class="cta-ghost" href="/contact/">Request a quote</a>
      </div>
    </div>
  </section>

  <div class="wrap">
    <article class="prose"><Content /></article>
  </div>

  <section class="section alt">
    <div class="wrap">
      <h2>Our tree services in {site.location.city}</h2>
      <ServiceGrid />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Areas we serve around {site.location.county}</h2>
      <TownGrid />
    </div>
  </section>
</BaseLayout>
